{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tevy",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Served only on the custom domain; wrangler creates the DNS record and certificate.
  "routes": [{ "pattern": "tevy.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
