/models/*
  Access-Control-Allow-Origin: *

/skies/*
  Access-Control-Allow-Origin: *

/models.json
  Access-Control-Allow-Origin: *

/skies.json
  Access-Control-Allow-Origin: *

/llms.txt
  Access-Control-Allow-Origin: *

# Pinned files: a version's files never change.
/models/:slug/:version/:file
  Cache-Control: public, max-age=31536000, immutable

/skies/:slug/:version/:file
  Cache-Control: public, max-age=31536000, immutable

# Latest files, previews and metadata change when a new version ships.
/models/:slug/:file
  Cache-Control: public, max-age=600

/skies/:slug/:file
  Cache-Control: public, max-age=600
