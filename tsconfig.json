{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "skipLibCheck": true,
    "types": ["$app/types", "node"],
    "paths": { "#lib/*": ["./site/src/lib/*"] }
  },
  "include": ["site/src", "*.js"],
  "exclude": ["site/src/service-worker"]
}
